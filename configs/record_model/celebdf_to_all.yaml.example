# Copy to celebdf_to_all.yaml and replace {canonical_root} and {record_model_runs} with local paths.
output_dir: "{record_model_runs}/calibrated_celebdf"
run_name: calibrated_celebdf_to_all
train_features_csv: "{canonical_root}/features/calibrated_features_celebdf_train.csv"
eval_feature_csvs:
  - name: ffpp_test
    path: "{canonical_root}/features/calibrated_features_ffpp_test.csv"
  - name: dfdc_test
    path: "{canonical_root}/features/calibrated_features_dfdc_test.csv"
  - name: celebdf_test
    path: "{canonical_root}/features/calibrated_features_celebdf_test.csv"
variants: [full_record_model]
seeds: [0, 1, 2]
train:
  steps: 1000
  batch_size: 1024
  hidden_dim: 64
  lr: 0.001
