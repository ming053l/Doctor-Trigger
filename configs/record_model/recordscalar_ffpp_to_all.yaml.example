# Copy to recordscalar_ffpp_to_all.yaml and replace each {placeholder} with its value from config.yaml
# (the trainer reads paths as written; relative ones resolve against this file).
# Trains the record model f_theta (Sec. 3.3) on the record-reference feature table x = Phi(J, R) written by
# experiments/features_release_scalars.py: C against the stored template T_I, the G_s family divided by the
# stored release projection. Read by workflow/record_model/train_record_model.py (registry: record-model-recordscalar).
output_dir: "{record_model_runs}/recordscalar_ffpp"
run_name: recordscalar_ffpp_to_all
train_features_csv: "{outputs_root}/features_record_scalar/recordscalar_features_ffpp_train.csv"
eval_feature_csvs:
  - name: ffpp_test
    path: "{outputs_root}/features_record_scalar/recordscalar_features_ffpp_test.csv"
  - name: dfdc_test
    path: "{outputs_root}/features_record_scalar/recordscalar_features_dfdc_test.csv"
  - name: celebdf_test
    path: "{outputs_root}/features_record_scalar/recordscalar_features_celebdf_test.csv"
variants: [host_only, trigger_only, host_plus_trigger, full_record_model]
seeds: [0, 1, 2]
train:
  steps: 1000
  batch_size: 1024
  hidden_dim: 64
  lr: 0.001
