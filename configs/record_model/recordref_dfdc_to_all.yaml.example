# Copy to recordref_dfdc_to_all.yaml and replace the placeholders with the paths in config.yaml.
# Same training as dfdc_to_all, on features whose reference is the stored template phase
# (experiments/features_record_ref.py) instead of the released PNG.
output_dir: "{record_model_runs}/recordref_dfdc"
run_name: recordref_dfdc_to_all
train_features_csv: "{outputs_root}/features_record_ref/recordref_features_dfdc_train.csv"
eval_feature_csvs:
  - name: ffpp_test
    path: "{outputs_root}/features_record_ref/recordref_features_ffpp_test.csv"
  - name: dfdc_test
    path: "{outputs_root}/features_record_ref/recordref_features_dfdc_test.csv"
  - name: celebdf_test
    path: "{outputs_root}/features_record_ref/recordref_features_celebdf_test.csv"
variants: [full_record_model]
seeds: [0, 1, 2]
train:
  steps: 1000
  batch_size: 1024
  hidden_dim: 64
  lr: 0.001
